---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import BannerImages from '../components/BannerImages.astro';
import SectionBackground from '../components/SectionBackground.astro';
import EducationCard from '../components/EducationCard.astro';
import EmploymentCard from '../components/EmploymentCard.astro';
import { employment, education, skills } from '../data/content';

const images = [
  { src: '/img/back/back5.webp' },
  { src: '/img/back/back1.webp' },
  { src: '/img/back/back2.webp' },
];

const languages = [
  { name: 'Spanish',  value: 100, label: 'Native' },
  { name: 'English',  value: 70,  label: 'Upper-Intermediate' },
  { name: 'Catalan',  value: 100, label: 'Native' },
];
---

<Layout
  title="Background | Vicent Sanjaime — GIS Developer & Consultant"
  description="Professional background of Vicent Sanjaime: GIS consultant at CARTO, front-end developer with Vue.js and React, geospatial specialist with 20+ years of experience in Valencia, Spain."
  ogImage="https://vicentsanjaime.net/img/back/back5.webp"
  canonicalPath="/background"
  schemas={[{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vicentsanjaime.net' },
      { '@type': 'ListItem', position: 2, name: 'Background', item: 'https://vicentsanjaime.net/background' },
    ],
  }]}
>
  <div class="vs-page">
    <Header currentPage="background" />
    <BannerImages images={images} interval={10000} bannerId="background-banner" />

    <main class="vs-content" id="vs-bio-info">
      <div class="vs-container">

        <!-- Bio -->
        <SectionBackground title="Bio">
          <div class="vs-bio">
            Developer of geospatial applications and{' '}
            <a href="https://en.wikipedia.org/wiki/Geographic_information_system">GIS</a> consultant,
            currently working at <a href="https://carto.com/">CARTO</a> as part of the Professional Services team.
            I love front-end development
            and usually work with <a href="https://vuejs.org/">Vue</a> and web mapping libraries such as{' '}
            <a href="https://openlayers.org/">OpenLayers</a>,{' '}
            <a href="https://leafletjs.com/">Leaflet</a>,{' '}
            <a href="https://developers.google.com/maps/documentation/javascript/overview">Google Maps API</a>,{' '}
            <a href="https://deck.gl">Deck.gl</a> and <a href="https://carto.com/">CARTO</a>.
            I also have extensive experience in the installation and management of server components
            such as spatial databases and map servers. I have worked on a large number of GIS projects,
            always integrating different technologies and components, most of them{' '}
            <a href="https://en.wikipedia.org/wiki/Open-source_model">open-source</a>.
          </div>
          <div class="vs-bio vs-bio--gap">
            I enjoy working on projects with a strong spatial component, as they allow me to apply my
            background in cartography, geography and geodesy to the development of spatial solutions.
            I consider myself an adaptable, collaborative and approachable team player with a keen
            interest in new technologies.
          </div>
          <div class="vs-bio vs-bio--gap">
            <p class="vs-skills-intro">Among my technical skill set I would highlight:</p>
            <ul class="vs-skills-list">
              {skills.map((group) => (
                <li class="vs-skills-row">
                  {group.techs.map((tech) => (
                    <span class="vs-skill-chip" style={`background-color: ${group.color}`}>
                      <i class="mdi mdi-label"></i>
                      {tech}
                    </span>
                  ))}
                </li>
              ))}
            </ul>
          </div>
        </SectionBackground>

        <!-- Education -->
        <SectionBackground title="Education">
          <div class="vs-cards-row">
            {education.map((info) => <EducationCard info={info} />)}
          </div>
        </SectionBackground>

        <!-- Employment -->
        <SectionBackground title="Employment history">
          <div class="vs-cards-row">
            {employment.map((info) => <EmploymentCard info={info} />)}
          </div>
        </SectionBackground>

        <!-- Languages -->
        <SectionBackground title="Languages">
          <div class="vs-languages">
            {languages.map((lang) => (
              <div class="vs-lang-block">
                <p class="vs-lang-name">{lang.name}</p>
                <div class="vs-progress-bar">
                  <div class="vs-progress-fill" style={`width: ${lang.value}%`}>
                    {lang.label}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </SectionBackground>

        <div style="height: 100px"></div>
      </div>
    </main>
  </div>
</Layout>

<!-- Shadow on banner when content is scrolled -->
<script>
  const banner = document.getElementById('background-banner');
  const content = document.getElementById('vs-bio-info');

  content?.addEventListener('scroll', () => {
    banner?.classList.toggle('vs-banner--scrolled', (content.scrollTop ?? 0) > 5);
  });
</script>

<style>
  .vs-page {
    display: flex;
    flex-direction: column;
    height: 100vh;
    overflow: hidden;
  }

  .vs-content {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
  }

  .vs-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px;
  }

  /* Bio text */
  .vs-bio {
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-text-sec);
    margin: 0 16px;
    line-height: 1.8;
  }

  .vs-bio a {
    color: var(--color-link-text);
    font-weight: 500;
    transition: color 0.15s;
  }

  .vs-bio a:hover {
    color: var(--color-accent-dk);
  }

  .vs-bio--gap {
    margin-top: 14px;
  }

  .vs-skills-intro {
    margin-bottom: 10px;
    color: var(--color-text);
    font-weight: 500;
  }

  /* Skills list: override global ul li::before */
  .vs-skills-list {
    padding-left: 0;
  }

  .vs-skills-list li::before {
    content: '' !important;
    display: none;
  }

  .vs-skills-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 6px;
  }

  .vs-skill-chip {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    color: white;
    font-size: 0.72rem;
    font-weight: 500;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    opacity: 0.92;
    transition: opacity 0.15s, transform 0.15s;
  }

  .vs-skill-chip:hover {
    opacity: 1;
    transform: translateY(-1px);
  }

  /* Cards grid */
  .vs-cards-row {
    display: flex;
    flex-wrap: wrap;
    margin: 0 4px;
  }

  /* Languages */
  .vs-languages {
    margin: 8px 16px 0;
  }

  .vs-lang-block {
    margin-bottom: 16px;
  }

  .vs-lang-name {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 8px;
  }

  .vs-progress-bar {
    width: 30%;
    background: var(--color-border);
    border-radius: var(--radius-pill);
    height: 22px;
    overflow: hidden;
  }

  .vs-progress-fill {
    height: 100%;
    background: var(--color-accent);
    border-radius: var(--radius-pill);
    color: white;
    font-size: 0.72rem;
    font-weight: 500;
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    padding: 0 12px;
  }

  @media (min-width: 700px) and (max-width: 1000px) {
    .vs-progress-bar { width: 50%; }
  }

  @media (max-width: 700px) {
    .vs-progress-bar { width: 80%; }
  }
</style>

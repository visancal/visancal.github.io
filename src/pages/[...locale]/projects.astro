---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import BannerImages from '../../components/BannerImages.astro';
import TimelineCard from '../../components/TimelineCard.astro';
import ProjectMeta from '../../components/ProjectMeta.astro';
import Footer from '../../components/Footer.astro';
import { projects } from '../../data/content';
import { breadcrumbSchema, getLang, localeStaticPaths, ui } from '../../data/i18n';

export const getStaticPaths = localeStaticPaths;

const lang = getLang(Astro.url);
const text = ui[lang].projects;

const images = ['/img/back/back5.webp', '/img/back/back6.webp'];
---

<Layout
  title={text.title}
  description={text.description}
  ogImage="https://vicentsanjaime.net/img/back/back5.webp"
  schemas={[breadcrumbSchema(lang, 'projects')]}
>
  <div class="vs-page">
    <Header currentPage="projects" />
    <BannerImages images={images} />

    <main class="vs-content">
      <div class="vs-container">
        <div class="vs-intro">
          <h1 class="vs-page-title">{text.heading}</h1>
          <p class="vs-intro-text">{text.intro}</p>
        </div>

        <!-- Timeline: cards alternate right (even) / left (odd) of the centre line -->
        <ol class="vs-timeline">
          {projects.map((project, index) => (
            <li class:list={['vs-timeline-item', { 'vs-item--left': index % 2 === 1 }]}>
              <ProjectMeta project={project} class="vs-opp" />
              <div class="vs-dot"></div>
              <div class="vs-card-wrap">
                <TimelineCard project={project} />
              </div>
            </li>
          ))}
        </ol>
      </div>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .vs-container {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 8px 20px;
  }

  .vs-intro {
    margin: 8px 8px 0;
  }

  .vs-intro-text {
    margin-bottom: 8px;
  }

  .vs-timeline {
    position: relative;
    padding: 16px 0;
    list-style: none;
  }

  .vs-timeline::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-border);
  }

  .vs-timeline-item {
    display: flex;
    align-items: flex-start;
    margin: 10px 0;
  }

  .vs-item--left {
    flex-direction: row-reverse;
  }

  .vs-timeline-item > :global(.vs-opp) {
    width: calc(50% - 20px);
    padding: 16px 12px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }

  .vs-item--left > :global(.vs-opp) {
    align-items: flex-start;
  }

  /* 40px column centred on the line */
  .vs-dot {
    width: 10px;
    height: 10px;
    margin: 22px 15px 0;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--color-accent);
    border: 2px solid var(--color-bg);
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  .vs-card-wrap {
    width: calc(50% - 20px);
    padding: 8px;
  }

  /* Mobile: single column, line on the left */
  @media (max-width: 600px) {
    .vs-timeline::before {
      left: 20px;
    }

    .vs-item--left {
      flex-direction: row;
    }

    .vs-timeline-item > :global(.vs-opp) {
      display: none;
    }

    .vs-card-wrap {
      width: calc(100% - 40px);
    }
  }
</style>

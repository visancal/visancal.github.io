---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HomeCarousel from '../components/HomeCarousel.astro';

const slides = [
  { src: '/img/home/intro.webp',  srcMobile: '/img/home/intro-m.webp',  position: '28% 22%', place: 'Griffith Observatory, LA',          credits: '@xurxosanz', link: 'https://twitter.com/xurxosanz' },
  { src: '/img/home/intro2.webp', srcMobile: '/img/home/intro2-m.webp', position: '62% 30%', place: 'Badwater Basin, Death Valley, CA',  credits: '@xurxosanz', link: 'https://twitter.com/xurxosanz' },
  { src: '/img/home/intro3.webp', srcMobile: '/img/home/intro3-m.webp', position: '50% 65%', place: 'Angkor Wat, Cambodia',              credits: 'Nerea' },
  { src: '/img/home/intro4.webp', srcMobile: '/img/home/intro4-m.webp', position: '65% 38%', place: 'Caldera de Taburiente, La Palma',   credits: 'Nerea' },
  { src: '/img/home/intro5.webp', srcMobile: '/img/home/intro5-m.webp', position: '43% 28%', place: 'Segla, Senja Island, Norway',       credits: 'Nerea' },
];
---

<Layout
  title="Vicent Sanjaime | GIS Developer, AI Enthusiast & Travel Lover"
  description="Personal website of Vicent Sanjaime Calvet — GIS developer and consultant at CARTO Professional Services, based in Valencia, Spain. Passionate about geospatial technology, AI, cycling and travel."
  canonicalPath="/"
  schemas={[{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Vicent Sanjaime',
    url: 'https://vicentsanjaime.net',
    description: 'Personal website of Vicent Sanjaime Calvet — GIS developer and consultant at CARTO Professional Services, based in Valencia, Spain.',
    author: { '@type': 'Person', name: 'Vicent Sanjaime', alternateName: ['Vicente Sanjaime', 'Vicente Sanjaime Calvet', 'Vicent Sanjaime Calvet'] },
  }]}
>
  <!-- The carousel sits behind the semi-transparent header -->
  <div class="vs-home">
    <HomeCarousel slides={slides} interval={5000} />
    <Header currentPage="home" />
  </div>
</Layout>

<style>
  .vs-home {
    position: relative;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }
</style>

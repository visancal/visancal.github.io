---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HomeCarousel from '../components/HomeCarousel.astro';

const slides = [
  {
    src: '/img/home/intro.webp',
    srcMobile: '/img/home/intro-m.webp',
    credits: '@xurxosanz',
    link: 'https://twitter.com/xurxosanz',
    place: 'Griffith Observatory, LA',
    bgPosition: '28% 22%',
    bgPositionMobile: '85% 50%',
  },
  {
    src: '/img/home/intro2.webp',
    srcMobile: '/img/home/intro2-m.webp',
    credits: '@xurxosanz',
    link: 'https://twitter.com/xurxosanz',
    place: 'Badwater Basin, Death Valley, CA',
    bgPosition: '62% 30%',
    bgPositionMobile: '85% 50%',
  },
  {
    src: '/img/home/intro3.webp',
    srcMobile: '/img/home/intro3-m.webp',
    credits: 'Nerea',
    link: '',
    place: 'Angkor Wat, Cambodia',
    bgPosition: '50% 65%',
    bgPositionMobile: '85% 50%',
  },
  {
    src: '/img/home/intro4.webp',
    srcMobile: '/img/home/intro4-m.webp',
    credits: 'Nerea',
    link: '',
    place: 'Caldera de Taburiente, La Palma',
    bgPosition: '65% 38%',
    bgPositionMobile: '85% 50%',
  },
  {
    src: '/img/home/intro5.webp',
    srcMobile: '/img/home/intro5-m.webp',
    credits: 'Nerea',
    link: '',
    place: 'Segla, Senja Island, Norway',
    bgPosition: '43% 28%',
    bgPositionMobile: '85% 50%',
  },
];
---

<Layout
  title="Vicent Sanjaime | GIS Developer, AI Enthusiast & Travel Lover"
  description="Personal website of Vicent Sanjaime — GIS developer and consultant at CARTO Professional Services, based in Valencia, Spain. Passionate about geospatial technology, AI, cycling and travel."
  canonicalPath="/"
  schemas={[{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Vicent Sanjaime',
    url: 'https://vicentsanjaime.net',
    description: 'Personal website of Vicent Sanjaime — GIS developer and consultant at CARTO Professional Services, based in Valencia, Spain.',
    author: { '@type': 'Person', name: 'Vicent Sanjaime' },
  }]}
>
  <!--
    The carousel sits behind the header (position: absolute, z-index: 0).
    The header overlays it with semi-transparent background (z-index: 100).
  -->
  <div class="vs-home">
    <HomeCarousel slides={slides} interval={5000} />
    <Header currentPage="home" />
  </div>
</Layout>

<style>
  .vs-home {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }
</style>

---
import ProjectMeta from './ProjectMeta.astro';
import type { Project } from '../data/content';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="vs-card vs-project">
  <h2 class="vs-card-title vs-project-title">{project.title}</h2>
  {project.description && <p class="vs-project-desc">{project.description}</p>}
  {project.url && (
    <a href={project.url} target="_blank" rel="noopener noreferrer" class="vs-project-url">{project.url}</a>
  )}

  <!-- Date + company live inside the card only on mobile (opposite side on desktop) -->
  <ProjectMeta project={project} class="vs-mobile-meta" />

  <div class="vs-tech-chips">
    {project.technologies.map((tech) => <span class="vs-chip vs-chip--tech">{tech}</span>)}
  </div>
</article>

<style>
  .vs-project {
    padding: 20px;
  }

  .vs-project:hover {
    transform: translateY(-1px);
  }

  .vs-project-title {
    font-size: 1.25rem;
    line-height: 1.35;
    margin-bottom: 10px;
  }

  .vs-project-desc {
    font-size: 0.875rem;
    color: var(--color-text-sec);
    margin-bottom: 10px;
    line-height: 1.6;
  }

  .vs-project-url {
    display: block;
    color: var(--color-accent);
    font-size: 0.78rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 10px;
    transition: color 0.15s;
  }

  .vs-project-url:hover {
    color: var(--color-accent-dk);
  }

  .vs-project :global(.vs-mobile-meta) {
    display: none;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 10px;
  }

  .vs-tech-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 12px;
  }

  @media (max-width: 600px) {
    .vs-project :global(.vs-mobile-meta) {
      display: flex;
    }
  }
</style>

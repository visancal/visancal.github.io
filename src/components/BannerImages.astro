---
interface Image {
  src: string;
}

interface Props {
  images: Image[];
  interval?: number;
  bannerId: string;
}

const { images, interval = 10000, bannerId } = Astro.props;
---

<div class="vs-banner" id={bannerId} data-banner data-interval={interval}>
  {images.map((image, i) => (
    <div
      class:list={['vs-banner-slide', { 'vs-banner-slide--active': i === 0 }]}
      style={`background-image: url('${image.src}')`}
    ></div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-banner]').forEach((el) => {
    const slides = el.querySelectorAll<HTMLElement>('.vs-banner-slide');
    const ms = parseInt(el.dataset.interval ?? '10000', 10);
    let cur = 0;

    setInterval(() => {
      slides[cur].classList.remove('vs-banner-slide--active');
      cur = (cur + 1) % slides.length;
      slides[cur].classList.add('vs-banner-slide--active');
    }, ms);
  });
</script>

<style>
  .vs-banner {
    position: relative;
    width: 100%;
    height: 140px;
    overflow: hidden;
    flex-shrink: 0;
    transition: box-shadow 0.3s ease;
  }

  .vs-banner.vs-banner--scrolled {
    box-shadow: -2px 10px 5px -6px rgba(138, 134, 138, 1);
    z-index: 10;
  }

  .vs-banner-slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 1s ease-in-out;
    /* Warm the images to match the earthy cream palette */
    filter: saturate(0.45) sepia(0.45) brightness(0.92);
  }

  .vs-banner-slide--active {
    opacity: 1;
  }

  @media (max-width: 600px) {
    .vs-banner {
      height: 50px;
    }
  }
</style>

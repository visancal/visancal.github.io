---
interface Props {
  images: string[];
  interval?: number;
}

const { images, interval = 10000 } = Astro.props;
---

<div class="vs-banner" data-rotator data-interval={interval}>
  {images.map((src, i) => (
    <img
      class:list={['vs-banner-slide', { 'is-active': i === 0 }]}
      data-slide
      src={i === 0 ? src : undefined}
      data-src={i === 0 ? undefined : src}
      alt=""
      decoding="async"
    />
  ))}
</div>

<script>
  import '../scripts/rotator';

  // Drop a shadow under the banner once the sibling <main> is scrolled
  document.addEventListener('astro:page-load', () => {
    const banner = document.querySelector('.vs-banner');
    const main = banner?.parentElement?.querySelector('main');
    main?.addEventListener('scroll', () => banner!.classList.toggle('is-scrolled', main.scrollTop > 5), { passive: true });
  });
</script>

<style>
  .vs-banner {
    position: relative;
    height: 140px;
    overflow: hidden;
    flex-shrink: 0;
    transition: box-shadow 0.3s ease;
  }

  .vs-banner.is-scrolled {
    box-shadow: -2px 10px 5px -6px rgba(138, 134, 138, 1);
    z-index: 10;
  }

  .vs-banner-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1s ease-in-out;
    /* Warm the images to match the earthy palette */
    filter: saturate(0.45) sepia(0.45) brightness(0.92);
  }

  .vs-banner-slide.is-active {
    opacity: 1;
  }

  @media (max-width: 600px) {
    .vs-banner {
      height: 50px;
    }
  }
</style>

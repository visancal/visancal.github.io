---
import SocialLinks from './SocialLinks.astro';
---

<footer class="vs-footer">
  <div class="vs-footer-social">
    <SocialLinks linkClass="vs-social-btn" />
  </div>
  <div class="vs-footer-end">
    Developed with <span class="vs-love">&hearts;</span> by Vicent
  </div>
</footer>

<style>
  /* 3-column grid keeps the icons centred regardless of the credit width */
  .vs-footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 40px;
    flex-shrink: 0;
    padding: 0 max(24px, calc((100% - 1152px) / 2));
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }

  .vs-footer-social {
    grid-column: 2;
    display: flex;
    gap: 4px;
  }

  .vs-footer-social :global(.vs-social-btn) {
    color: var(--color-text-sec);
    font-size: 16px;
    display: inline-flex;
    padding: 5px 8px;
    border-radius: var(--radius-pill);
    transition: color 0.15s, background 0.15s;
  }

  .vs-footer-social :global(.vs-social-btn:hover) {
    color: var(--color-accent);
    background: rgba(var(--color-accent-rgb), 0.1);
  }

  .vs-footer-end {
    text-align: right;
    font-size: 0.78rem;
    color: var(--color-text-sec);
  }

  .vs-love {
    color: var(--color-accent);
    padding: 0 3px;
  }

  @media (max-width: 600px) {
    .vs-footer {
      display: none;
    }
  }
</style>

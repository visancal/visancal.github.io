---
interface Props {
  currentPage?: 'home' | 'background' | 'projects';
}

const { currentPage = 'home' } = Astro.props;
const isHome = currentPage === 'home';
---

<header class="vs-header">
  <!-- Main bar -->
  <div class="vs-appbar">
    <a href="/" class="vs-title">Vicent Sanjaime</a>
    <div class="vs-spacer"></div>

    <!-- Desktop nav -->
    <nav class="vs-nav-desktop" aria-label="Main navigation">
      <a href="/" class:list={['vs-nav-btn', { 'vs-nav-btn--active': currentPage === 'home' }]}>Home</a>
      <a href="/background" class:list={['vs-nav-btn', { 'vs-nav-btn--active': currentPage === 'background' }]}>Background</a>
      <a href="/projects" class:list={['vs-nav-btn', { 'vs-nav-btn--active': currentPage === 'projects' }]}>Projects</a>
    </nav>

    <!-- Mobile hamburger -->
    <button class="vs-hamburger" id="menu-toggle" aria-label="Open menu">
      <i class="mdi mdi-menu"></i>
    </button>
  </div>

  <!-- Social bar (only on home page) -->
  {isHome && (
    <div class="vs-social-bar">
      <div class="vs-spacer"></div>
      <a href="https://twitter.com/visancal" target="_blank" rel="noopener noreferrer" aria-label="Twitter" class="vs-social-btn">
        <i class="mdi mdi-twitter"></i>
      </a>
      <a href="https://www.instagram.com/visancal/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="vs-social-btn">
        <i class="mdi mdi-instagram"></i>
      </a>
      <a href="https://www.linkedin.com/in/vsanjaime/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="vs-social-btn">
        <i class="mdi mdi-linkedin"></i>
      </a>
      <a href="https://github.com/visancal" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="vs-social-btn">
        <i class="mdi mdi-github"></i>
      </a>
      <a href="https://strava.app.link/qXSmcgCTZ2b" target="_blank" rel="noopener noreferrer" aria-label="Strava" class="vs-social-btn">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="1em" height="1em" aria-hidden="true"><path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/></svg>
      </a>
    </div>
  )}

  <!-- Mobile drawer -->
  <div class="vs-drawer" id="mobile-drawer" aria-hidden="true">
    <div class="vs-drawer-title">Vicent Sanjaime</div>
    <nav>
      <a href="/" class="vs-drawer-item">Home</a>
      <a href="/background" class="vs-drawer-item">Background</a>
      <a href="/projects" class="vs-drawer-item">Projects</a>
    </nav>
  </div>
  <div class="vs-overlay" id="drawer-overlay"></div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const drawer = document.getElementById('mobile-drawer');
  const overlay = document.getElementById('drawer-overlay');

  function openDrawer() {
    drawer?.classList.add('open');
    overlay?.classList.add('open');
    drawer?.setAttribute('aria-hidden', 'false');
  }

  function closeDrawer() {
    drawer?.classList.remove('open');
    overlay?.classList.remove('open');
    drawer?.setAttribute('aria-hidden', 'true');
  }

  toggle?.addEventListener('click', () => {
    drawer?.classList.contains('open') ? closeDrawer() : openDrawer();
  });
  overlay?.addEventListener('click', closeDrawer);
</script>

<style>
  .vs-header {
    position: relative;
    z-index: 100;
    flex-shrink: 0;
  }

  .vs-appbar {
    display: flex;
    align-items: center;
    height: 72px;
    padding: 0 24px;
    background: rgba(245, 239, 227, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .vs-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .vs-spacer {
    flex: 1;
  }

  .vs-nav-desktop {
    display: flex;
    align-items: center;
    gap: 2px;
    padding-right: 8px;
  }

  .vs-nav-btn {
    color: var(--color-text-sec);
    font-family: var(--font-main);
    font-weight: 400;
    font-size: 0.9rem;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    transition: color 0.15s, background 0.15s;
  }

  .vs-nav-btn--active {
    color: var(--color-text);
    background: rgba(217, 119, 87, 0.12);
    font-weight: 500;
  }

  .vs-nav-btn:hover:not(.vs-nav-btn--active) {
    color: var(--color-text);
    background: rgba(26, 16, 8, 0.06);
  }

  /* Social bar */
  .vs-social-bar {
    display: flex;
    align-items: center;
    height: 32px;
    padding: 0 24px;
    border-bottom: 1px solid var(--color-border);
    background: rgba(245, 239, 227, 0.6);
  }

  .vs-social-btn {
    color: var(--color-text-sec);
    font-size: 17px;
    margin-right: 12px;
    display: inline-flex;
    align-items: center;
    transition: color 0.15s;
  }

  .vs-social-btn:hover {
    color: var(--color-accent);
  }

  /* Hamburger */
  .vs-hamburger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.4rem;
    color: var(--color-text);
    padding: 8px;
  }

  /* Mobile drawer */
  .vs-drawer {
    position: fixed;
    top: 0;
    left: -300px;
    width: 280px;
    height: 100vh;
    background: var(--color-bg);
    border-right: 1px solid var(--color-border);
    z-index: 20000;
    transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .vs-drawer.open {
    left: 0;
  }

  .vs-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(26, 16, 8, 0.35);
    z-index: 19999;
    backdrop-filter: blur(2px);
  }

  .vs-overlay.open {
    display: block;
  }

  .vs-drawer-title {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 500;
    padding: 36px 20px 32px;
    border-bottom: 1px solid var(--color-border);
  }

  .vs-drawer-item {
    display: block;
    color: var(--color-text-sec);
    font-size: 1rem;
    font-weight: 400;
    padding: 14px 20px;
    border-bottom: 1px solid var(--color-border);
    transition: color 0.15s, background 0.15s;
  }

  .vs-drawer-item:hover {
    color: var(--color-text);
    background: rgba(217, 119, 87, 0.08);
  }

  @media (max-width: 600px) {
    .vs-appbar {
      height: 60px;
      padding: 0 16px;
    }
    .vs-title {
      font-size: 1.2rem;
    }
    .vs-nav-desktop {
      display: none;
    }
    .vs-hamburger {
      display: block;
    }
    .vs-social-bar {
      display: none;
    }
  }
</style>

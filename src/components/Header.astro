---
import SocialLinks from './SocialLinks.astro';
import { LANGS, LANG_META, getLang, localizePath, routePath, ui } from '../data/i18n';

interface Props {
  currentPage?: 'home' | 'background' | 'projects' | 'trips';
}

const { currentPage = 'home' } = Astro.props;
const isHome = currentPage === 'home';
const lang = getLang(Astro.url);
const text = ui[lang];
const route = routePath(Astro.url);

// Feather-style stroke icons, one path list per section
const navItems = [
  { key: 'home', href: localizePath('/', lang), label: text.nav.home, paths: ['M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z', 'M9 22V12h6v10'] },
  { key: 'background', href: localizePath('/background', lang), label: text.nav.background, paths: ['M6 16a3 3 0 1 0 0 6a3 3 0 1 0 0-6z', 'M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15', 'M18 2a3 3 0 1 0 0 6a3 3 0 1 0 0-6z'] },
  { key: 'projects', href: localizePath('/projects', lang), label: text.nav.projects, paths: ['M12 2L2 7l10 5 10-5-10-5z', 'M2 17l10 5 10-5', 'M2 12l10 5 10-5'] },
  { key: 'trips', href: localizePath('/trips', lang), label: text.nav.trips, paths: ['M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z', 'M12 7a3 3 0 1 0 0 6 3 3 0 0 0 0-6z'] },
] as const;
---

<header class="vs-header">
  <!-- Main bar -->
  <div class="vs-appbar">
    <a href={localizePath('/', lang)} class="vs-title">Vicent Sanjaime</a>

    <!-- Desktop nav -->
    <nav class="vs-nav-desktop" aria-label={text.mainNav}>
      {navItems.map((item) => (
        <a href={item.href} class:list={['vs-nav-btn', { 'vs-nav-btn--active': currentPage === item.key }]}>
          <svg class="vs-nav-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {item.paths.map((d) => <path d={d} />)}
          </svg>
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Language switcher: same page in another language -->
    <nav class="vs-lang" aria-label={text.language}>
      {LANGS.map((l) => (
        <a
          href={localizePath(route, l)}
          class:list={['vs-lang-btn', { 'vs-lang-btn--active': l === lang }]}
          hreflang={LANG_META[l].hreflang}
          lang={LANG_META[l].htmlLang}
          title={LANG_META[l].name}
          aria-current={l === lang ? 'true' : undefined}
          data-lang={l}
        >{l.toUpperCase()}</a>
      ))}
    </nav>

    <!-- Mobile hamburger -->
    <button class="vs-hamburger" id="menu-toggle" aria-label={text.openMenu} data-label-open={text.openMenu} data-label-close={text.closeMenu} aria-expanded="false" aria-controls="mobile-drawer">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
           fill="none" stroke="currentColor" stroke-width="2"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
  </div>

  <!-- Social bar (only on home page) -->
  {isHome && (
    <div class="vs-social-bar">
      <SocialLinks linkClass="vs-social-btn" />
    </div>
  )}

  <!-- Mobile drawer — inert keeps descendants non-focusable while closed -->
  <div class="vs-drawer" id="mobile-drawer" aria-hidden="true" inert>
    <div class="vs-drawer-title">Vicent Sanjaime</div>
    <nav aria-label={text.mobileNav}>
      {navItems.map((item) => (
        <a href={item.href} class="vs-drawer-item">
          <svg class="vs-nav-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {item.paths.map((d) => <path d={d} />)}
          </svg>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
  <div class="vs-overlay" id="drawer-overlay"></div>
</header>

<script>
  function initDrawer() {
    const toggle = document.getElementById('menu-toggle');
    const drawer = document.getElementById('mobile-drawer');
    const overlay = document.getElementById('drawer-overlay');
    if (!toggle || !drawer || !overlay) return;

    const setOpen = (open: boolean) => {
      drawer.classList.toggle('open', open);
      overlay.classList.toggle('open', open);
      drawer.toggleAttribute('inert', !open);
      drawer.setAttribute('aria-hidden', String(!open));
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '');
    };

    toggle.addEventListener('click', () => setOpen(!drawer.classList.contains('open')));
    overlay.addEventListener('click', () => setOpen(false));
  }

  // Re-run after every ClientRouter navigation (the header is swapped)
  document.addEventListener('astro:page-load', initDrawer);

  // Remember an explicit language choice so the English pages stop redirecting (see Layout)
  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>('a[data-lang]');
    if (!link) return;
    try {
      localStorage.setItem('vs-lang', link.dataset.lang!);
    } catch {}
  });
</script>

<style>
  .vs-header {
    position: relative;
    z-index: 100;
    flex-shrink: 0;
  }

  .vs-appbar {
    display: flex;
    align-items: center;
    height: 72px;
    padding: 0 24px;
    background: var(--color-surface-translucent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .vs-title {
    font-family: var(--font-display);
    font-weight: 550;
    font-size: 1.6875rem;
    color: var(--color-accent-dk);
    letter-spacing: -0.01em;
    margin-right: auto;
  }

  .vs-nav-desktop {
    display: flex;
    align-items: center;
    gap: 2px;
    padding-right: 8px;
  }

  .vs-nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-text-sec);
    font-family: var(--font-main);
    font-weight: 400;
    font-size: 0.9rem;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    transition: color 0.15s, background 0.15s;
  }

  .vs-nav-icon {
    flex-shrink: 0;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .vs-nav-btn:hover .vs-nav-icon,
  .vs-drawer-item:hover .vs-nav-icon {
    transform: scale(1.15) rotate(-6deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .vs-nav-icon {
      transition: none;
    }
    .vs-nav-btn:hover .vs-nav-icon,
    .vs-drawer-item:hover .vs-nav-icon {
      transform: none;
    }
  }

  .vs-nav-btn--active {
    color: var(--color-text);
    background: rgba(var(--color-accent-rgb), 0.12);
    font-weight: 500;
  }

  .vs-nav-btn:hover:not(.vs-nav-btn--active) {
    color: var(--color-text);
    background: var(--color-hover-tint);
  }

  /* Language switcher */
  .vs-lang {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 0 4px;
  }

  /* Divider between the sections and the language switcher (desktop only) */
  .vs-lang::before {
    content: '';
    width: 1px;
    height: 20px;
    margin-right: 10px;
    background: #BDBDBD;
  }

  .vs-lang-btn {
    color: var(--color-text-sec);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 4px 8px;
    border-radius: var(--radius-pill);
    transition: color 0.15s, background 0.15s;
  }

  .vs-lang-btn:hover:not(.vs-lang-btn--active) {
    color: var(--color-text);
    background: var(--color-hover-tint);
  }

  .vs-lang-btn--active {
    color: var(--color-text);
    background: rgba(var(--color-accent-rgb), 0.12);
  }

  /* Social bar */
  .vs-social-bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: 32px;
    padding: 0 24px;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-translucent-soft);
  }

  .vs-social-bar :global(.vs-social-btn) {
    color: var(--color-text-sec);
    font-size: 17px;
    margin-right: 12px;
    display: inline-flex;
    transition: color 0.15s;
  }

  .vs-social-bar :global(.vs-social-btn:hover) {
    color: var(--color-accent);
  }

  /* Hamburger */
  .vs-hamburger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text);
    padding: 8px;
  }

  /* Mobile drawer */
  .vs-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 280px;
    height: 100%;
    transform: translateX(-100%);
    background: var(--color-bg);
    border-right: 1px solid var(--color-border);
    z-index: 20000;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .vs-drawer.open {
    transform: none;
  }

  .vs-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: var(--color-overlay-scrim);
    z-index: 19999;
    backdrop-filter: blur(2px);
  }

  .vs-overlay.open {
    display: block;
  }

  .vs-drawer-title {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 500;
    padding: 36px 20px 32px;
    border-bottom: 1px solid var(--color-border);
  }

  .vs-drawer-item {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--color-text-sec);
    font-size: 1rem;
    font-weight: 400;
    padding: 14px 20px;
    border-bottom: 1px solid var(--color-border);
    transition: color 0.15s, background 0.15s;
  }

  .vs-drawer-item:hover {
    color: var(--color-text);
    background: rgba(var(--color-accent-rgb), 0.08);
  }

  /* Narrow desktop/tablet: drop the nav icons so the sections still fit on one line */
  @media (max-width: 900px) {
    .vs-nav-desktop .vs-nav-icon {
      display: none;
    }
    .vs-title {
      white-space: nowrap;
    }
  }

  /* Just above the mobile breakpoint: tighter buttons and a smaller title */
  @media (max-width: 760px) {
    .vs-appbar {
      padding: 0 16px;
    }
    .vs-title {
      font-size: 1.3875rem;
      padding-right: 12px;
    }
    .vs-nav-btn {
      padding: 6px 8px;
    }
  }

  @media (max-width: 600px) {
    .vs-appbar {
      height: 60px;
      padding: 0 16px;
    }
    .vs-title {
      font-size: 1.3875rem;
    }
    .vs-nav-desktop {
      display: none;
    }
    .vs-hamburger {
      display: block;
    }
    .vs-lang::before {
      display: none;
    }
    .vs-lang-btn {
      padding: 4px 6px;
    }
    .vs-social-bar {
      display: none;
    }
  }
</style>

---
interface Props {
  currentPage?: 'home' | 'background' | 'projects';
}

const { currentPage = 'home' } = Astro.props;
const isHome = currentPage === 'home';
---

<header class="vs-header">
  <!-- Main bar -->
  <div class="vs-appbar">
    <a href="/" class="vs-title">Vicent Sanjaime</a>
    <div class="vs-spacer"></div>

    <!-- Desktop nav -->
    <nav class="vs-nav-desktop" aria-label="Main navigation">
      <a href="/" class:list={['vs-nav-btn', { 'vs-nav-btn--active': currentPage === 'home' }]}>Home</a>
      <a href="/background" class:list={['vs-nav-btn', { 'vs-nav-btn--active': currentPage === 'background' }]}>Background</a>
      <a href="/projects" class:list={['vs-nav-btn', { 'vs-nav-btn--active': currentPage === 'projects' }]}>Projects</a>
    </nav>

    <!-- Mobile hamburger -->
    <button class="vs-hamburger" id="menu-toggle" aria-label="Open menu">
      <i class="mdi mdi-menu"></i>
    </button>
  </div>

  <!-- Social bar (only on home page) -->
  {isHome && (
    <div class="vs-social-bar">
      <div class="vs-spacer"></div>
      <a href="https://twitter.com/visancal" target="_blank" rel="noopener noreferrer" aria-label="Twitter" class="vs-social-btn">
        <i class="mdi mdi-twitter"></i>
      </a>
      <a href="https://www.instagram.com/visancal/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="vs-social-btn">
        <i class="mdi mdi-instagram"></i>
      </a>
      <a href="https://www.linkedin.com/in/vsanjaime/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="vs-social-btn">
        <i class="mdi mdi-linkedin"></i>
      </a>
      <a href="https://github.com/visancal" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="vs-social-btn">
        <i class="mdi mdi-github"></i>
      </a>
    </div>
  )}

  <!-- Mobile drawer -->
  <div class="vs-drawer" id="mobile-drawer" aria-hidden="true">
    <div class="vs-drawer-title">Vicent Sanjaime</div>
    <nav>
      <a href="/" class="vs-drawer-item">Home</a>
      <a href="/background" class="vs-drawer-item">Background</a>
      <a href="/projects" class="vs-drawer-item">Projects</a>
    </nav>
  </div>
  <div class="vs-overlay" id="drawer-overlay"></div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const drawer = document.getElementById('mobile-drawer');
  const overlay = document.getElementById('drawer-overlay');

  function openDrawer() {
    drawer?.classList.add('open');
    overlay?.classList.add('open');
    drawer?.setAttribute('aria-hidden', 'false');
  }

  function closeDrawer() {
    drawer?.classList.remove('open');
    overlay?.classList.remove('open');
    drawer?.setAttribute('aria-hidden', 'true');
  }

  toggle?.addEventListener('click', () => {
    drawer?.classList.contains('open') ? closeDrawer() : openDrawer();
  });
  overlay?.addEventListener('click', closeDrawer);
</script>

<style>
  .vs-header {
    position: relative;
    z-index: 100;
    flex-shrink: 0;
  }

  .vs-appbar {
    display: flex;
    align-items: center;
    height: 80px;
    padding: 0 8px 0 16px;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(2px);
  }

  .vs-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 2.1rem;
    cursor: pointer;
    color: var(--color-primary);
    margin-left: 20px;
    animation: color-change 15s infinite;
  }

  .vs-spacer {
    flex: 1;
  }

  .vs-nav-desktop {
    display: flex;
    gap: 4px;
    padding-right: 32px;
  }

  .vs-nav-btn {
    color: #0d47a1;
    font-weight: 500;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: capitalize;
    padding: 6px 12px;
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }

  .vs-nav-btn--active {
    border-bottom-color: var(--color-accent);
    color: var(--color-primary);
    font-weight: 900;
  }

  .vs-nav-btn:hover:not(.vs-nav-btn--active) {
    color: var(--color-accent);
  }

  /* Social bar */
  .vs-social-bar {
    display: flex;
    align-items: center;
    height: 36px;
    padding: 0 8px;
  }

  .vs-social-btn {
    color: #c62828;
    font-size: 18px;
    margin-right: 16px;
    display: inline-flex;
    align-items: center;
    transition: color 0.2s;
  }

  .vs-social-btn:hover {
    color: var(--color-accent);
  }

  /* Hamburger */
  .vs-hamburger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.5rem;
    color: var(--color-primary);
    padding: 8px;
    margin-right: 8px;
  }

  /* Mobile drawer */
  .vs-drawer {
    position: fixed;
    top: 0;
    left: -300px;
    width: 280px;
    height: 100vh;
    background-color: var(--color-primary);
    z-index: 20000;
    transition: left 0.3s ease;
  }

  .vs-drawer.open {
    left: 0;
  }

  .vs-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 19999;
  }

  .vs-overlay.open {
    display: block;
  }

  .vs-drawer-title {
    color: white;
    font-family: var(--font-display);
    font-size: 1.5rem;
    padding: 40px 10px 40px;
  }

  .vs-drawer-item {
    display: block;
    color: white;
    font-size: 1.5rem;
    font-weight: 300;
    padding: 15px 20px;
    margin-top: 5px;
    transition: background 0.2s;
  }

  .vs-drawer-item:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  @keyframes color-change {
    0%   { color: var(--color-primary); }
    50%  { color: var(--color-accent); }
    100% { color: var(--color-primary); }
  }

  @media (max-width: 600px) {
    .vs-appbar {
      height: 60px;
    }
    .vs-title {
      font-size: 1.5rem;
    }
    .vs-nav-desktop {
      display: none;
    }
    .vs-hamburger {
      display: block;
    }
    .vs-social-bar {
      display: none;
    }
  }
</style>

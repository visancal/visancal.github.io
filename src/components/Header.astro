---
interface Props {
  currentPage?: 'home' | 'background' | 'projects' | 'trips';
}

const { currentPage = 'home' } = Astro.props;
const isHome = currentPage === 'home';

// Feather-style stroke icons, one path list per section
const navItems = [
  { key: 'home', href: '/', label: 'Home', paths: ['M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z', 'M9 22V12h6v10'] },
  { key: 'background', href: '/background', label: 'Background', paths: ['M4 7h16a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1z', 'M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2'] },
  { key: 'projects', href: '/projects', label: 'Projects', paths: ['M12 2L2 7l10 5 10-5-10-5z', 'M2 17l10 5 10-5', 'M2 12l10 5 10-5'] },
  { key: 'trips', href: '/trips', label: 'Trips', paths: ['M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z', 'M12 7a3 3 0 1 0 0 6 3 3 0 0 0 0-6z'] },
] as const;
---

<header class="vs-header">
  <!-- Main bar -->
  <div class="vs-appbar">
    <a href="/" class="vs-title">Vicent Sanjaime</a>
    <div class="vs-spacer"></div>

    <!-- Desktop nav -->
    <nav class="vs-nav-desktop" aria-label="Main navigation">
      {navItems.map((item) => (
        <a href={item.href} class:list={['vs-nav-btn', { 'vs-nav-btn--active': currentPage === item.key }]}>
          <svg class="vs-nav-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {item.paths.map((d) => <path d={d} />)}
          </svg>
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Mobile hamburger — inline SVG so MDI is not render-critical -->
    <button class="vs-hamburger" id="menu-toggle" aria-label="Open menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
           fill="none" stroke="currentColor" stroke-width="2"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
  </div>

  <!-- Social bar (only on home page) -->
  {isHome && (
    <div class="vs-social-bar">
      <div class="vs-spacer"></div>
      <a href="https://twitter.com/visancal" target="_blank" rel="noopener noreferrer" aria-label="Twitter" class="vs-social-btn">
        <i class="mdi mdi-twitter"></i>
      </a>
      <a href="https://www.instagram.com/visancal/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="vs-social-btn">
        <i class="mdi mdi-instagram"></i>
      </a>
      <a href="https://www.linkedin.com/in/vsanjaime/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="vs-social-btn">
        <i class="mdi mdi-linkedin"></i>
      </a>
      <a href="https://github.com/visancal" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="vs-social-btn">
        <i class="mdi mdi-github"></i>
      </a>
      <a href="https://strava.app.link/qXSmcgCTZ2b" target="_blank" rel="noopener noreferrer" aria-label="Strava" class="vs-social-btn">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="1em" height="1em" aria-hidden="true"><path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/></svg>
      </a>
    </div>
  )}

  <!-- Mobile drawer — inert keeps descendants non-focusable while closed -->
  <div class="vs-drawer" id="mobile-drawer" aria-hidden="true" inert>
    <div class="vs-drawer-title">Vicent Sanjaime</div>
    <nav aria-label="Mobile navigation">
      {navItems.map((item) => (
        <a href={item.href} class="vs-drawer-item">
          <svg class="vs-nav-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {item.paths.map((d) => <path d={d} />)}
          </svg>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
  <div class="vs-overlay" id="drawer-overlay"></div>
</header>

<script>
  function initDrawer() {
    const toggle = document.getElementById('menu-toggle') as HTMLButtonElement | null;
    const drawer = document.getElementById('mobile-drawer');
    const overlay = document.getElementById('drawer-overlay');

    function openDrawer() {
      drawer?.classList.add('open');
      overlay?.classList.add('open');
      drawer?.removeAttribute('inert');
      drawer?.setAttribute('aria-hidden', 'false');
      toggle?.setAttribute('aria-label', 'Close menu');
    }

    function closeDrawer() {
      drawer?.classList.remove('open');
      overlay?.classList.remove('open');
      drawer?.setAttribute('inert', '');
      drawer?.setAttribute('aria-hidden', 'true');
      toggle?.setAttribute('aria-label', 'Open menu');
    }

    toggle?.addEventListener('click', () => {
      drawer?.classList.contains('open') ? closeDrawer() : openDrawer();
    });
    overlay?.addEventListener('click', closeDrawer);
  }

  // Se re-ejecuta en cada navegación con View Transitions (ClientRouter)
  document.addEventListener('astro:page-load', initDrawer);
</script>

<style>
  .vs-header {
    position: relative;
    z-index: 100;
    flex-shrink: 0;
  }

  .vs-appbar {
    display: flex;
    align-items: center;
    height: 72px;
    padding: 0 24px;
    background: var(--color-surface-translucent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .vs-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .vs-spacer {
    flex: 1;
  }

  .vs-nav-desktop {
    display: flex;
    align-items: center;
    gap: 2px;
    padding-right: 8px;
  }

  .vs-nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-text-sec);
    font-family: var(--font-main);
    font-weight: 400;
    font-size: 0.9rem;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    transition: color 0.15s, background 0.15s;
  }

  .vs-nav-icon {
    flex-shrink: 0;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .vs-nav-btn:hover .vs-nav-icon,
  .vs-drawer-item:hover .vs-nav-icon {
    transform: scale(1.15) rotate(-6deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .vs-nav-icon {
      transition: none;
    }
    .vs-nav-btn:hover .vs-nav-icon,
    .vs-drawer-item:hover .vs-nav-icon {
      transform: none;
    }
  }

  .vs-nav-btn--active {
    color: var(--color-text);
    background: rgba(var(--color-accent-rgb), 0.12);
    font-weight: 500;
  }

  .vs-nav-btn:hover:not(.vs-nav-btn--active) {
    color: var(--color-text);
    background: var(--color-hover-tint);
  }

  /* Social bar */
  .vs-social-bar {
    display: flex;
    align-items: center;
    height: 32px;
    padding: 0 24px;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-translucent-soft);
  }

  .vs-social-btn {
    color: var(--color-text-sec);
    font-size: 17px;
    margin-right: 12px;
    display: inline-flex;
    align-items: center;
    transition: color 0.15s;
  }

  .vs-social-btn:hover {
    color: var(--color-accent);
  }

  /* Hamburger */
  .vs-hamburger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.4rem;
    color: var(--color-text);
    padding: 8px;
  }

  /* Mobile drawer */
  .vs-drawer {
    position: fixed;
    top: 0;
    left: -300px;
    width: 280px;
    height: 100vh;
    background: var(--color-bg);
    border-right: 1px solid var(--color-border);
    z-index: 20000;
    transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .vs-drawer.open {
    left: 0;
  }

  .vs-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: var(--color-overlay-scrim);
    z-index: 19999;
    backdrop-filter: blur(2px);
  }

  .vs-overlay.open {
    display: block;
  }

  .vs-drawer-title {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 500;
    padding: 36px 20px 32px;
    border-bottom: 1px solid var(--color-border);
  }

  .vs-drawer-item {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--color-text-sec);
    font-size: 1rem;
    font-weight: 400;
    padding: 14px 20px;
    border-bottom: 1px solid var(--color-border);
    transition: color 0.15s, background 0.15s;
  }

  .vs-drawer-item:hover {
    color: var(--color-text);
    background: rgba(var(--color-accent-rgb), 0.08);
  }

  @media (max-width: 600px) {
    .vs-appbar {
      height: 60px;
      padding: 0 16px;
    }
    .vs-title {
      font-size: 1.2rem;
    }
    .vs-nav-desktop {
      display: none;
    }
    .vs-hamburger {
      display: block;
    }
    .vs-social-bar {
      display: none;
    }
  }
</style>

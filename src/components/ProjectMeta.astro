---
import Icon from './Icon.astro';
import type { Project } from '../data/content';
import { getLang, ui } from '../data/i18n';

interface Props {
  project: Project;
  class?: string;
}

const { project, class: className } = Astro.props;
const text = ui[getLang(Astro.url)].projects;
const isPersonal = project.company === 'Personal';
const companyColor = isPersonal ? 'var(--color-badge-personal)' : 'var(--color-accent)';
---

<div class={className}>
  <span class="vs-chip vs-chip--date"><Icon name="calendar" />{project.date}</span>
  <span class="vs-chip" style={`background-color: ${companyColor}`}>{isPersonal ? text.personal : project.company}</span>
  {project.rd && <span class="vs-chip vs-chip--rd">{text.rd}</span>}
</div>

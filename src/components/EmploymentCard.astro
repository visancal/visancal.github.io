---
import Icon from './Icon.astro';
import type { Employment } from '../data/content';

interface Props {
  info: Employment;
}

const { info } = Astro.props;
---

<article class="vs-card">
  <img class="vs-card-img" src={info.img} alt="" loading="lazy" decoding="async" />
  <div class="vs-card-body">
    <h3 class="vs-card-title">{info.title}</h3>
    <a href={info.url} target="_blank" rel="noopener noreferrer" class="vs-card-link">{info.center}</a>
    <span class="vs-chip vs-chip--date"><Icon name="calendar" />{info.date}</span>
    <ul class="vs-task-list">
      {info.tasks.map((task) => <li>{task}</li>)}
    </ul>
  </div>
</article>

<style>
  .vs-card-img {
    width: 100%;
    height: 90px;
    object-fit: contain;
    display: block;
    padding: 16px 24px 0;
    filter: saturate(0.65) sepia(0.2) brightness(0.95);
  }

  .vs-card-body {
    padding: 20px;
  }

  .vs-card-title {
    font-size: 1.1rem;
    line-height: 1.4;
    margin-bottom: 6px;
  }

  .vs-card-link {
    display: block;
    margin-bottom: 10px;
  }

  .vs-chip {
    margin-bottom: 14px;
  }

  .vs-task-list {
    list-style: disc;
    padding-left: 1.3em;
  }

  .vs-task-list li {
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 5px;
    color: var(--color-text-sec);
  }

  .vs-task-list li::marker {
    color: var(--color-accent);
  }
</style>

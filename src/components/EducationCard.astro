---
import type { Education } from '../data/content';

interface Props {
  info: Education;
}

const { info } = Astro.props;
---

<div class="vs-card-wrap">
  <article class="vs-card">
    <img class="vs-card-img" src={info.img} alt={info.center} loading="lazy" />
    <div class="vs-card-body">
      <h3 class="vs-card-title">{info.title}</h3>
      <p class="vs-card-subtitle">{info.subtitle}</p>
      <div class="vs-card-text">
        <a href={info.url} target="_blank" rel="noopener noreferrer" class="vs-center-link">
          {info.center}
        </a>
        <div class="vs-date-chip">
          <i class="mdi mdi-calendar-month"></i>
          {info.date}
        </div>
        <img class="vs-edu-icon" src={info.icon} alt={info.center} loading="lazy" />
      </div>
    </div>
  </article>
</div>

<style>
  .vs-card-wrap {
    width: 100%;
    padding: 8px;
  }

  .vs-card {
    background: #fff;
    border-radius: 4px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.18);
    overflow: hidden;
  }

  .vs-card-img {
    width: 100%;
    height: 120px;
    object-fit: cover;
    display: block;
  }

  .vs-card-body {
    padding: 16px;
    position: relative;
  }

  .vs-card-title {
    color: var(--color-accent);
    font-weight: 500;
    font-size: 1.3rem;
    margin-bottom: 8px;
  }

  .vs-card-subtitle {
    color: var(--color-primary);
    font-size: 0.875rem;
    margin-bottom: 8px;
  }

  .vs-card-text {
    position: relative;
    padding-bottom: 65px;
  }

  .vs-center-link {
    color: var(--color-primary);
    text-transform: uppercase;
    font-size: 0.875rem;
    display: block;
    margin-bottom: 8px;
  }

  .vs-center-link:hover {
    color: var(--color-accent);
  }

  .vs-date-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: var(--color-primary);
    color: white;
    font-size: 0.75rem;
    padding: 2px 8px;
    border-radius: 2px;
  }

  .vs-edu-icon {
    width: 55px;
    height: 55px;
    position: absolute;
    bottom: 0;
    right: 0;
    border-radius: 50%;
    object-fit: cover;
  }

  @media (min-width: 768px) {
    .vs-card-wrap {
      width: 50%;
    }
  }

  @media (min-width: 1280px) {
    .vs-card-wrap {
      width: 33.333%;
    }
  }
</style>

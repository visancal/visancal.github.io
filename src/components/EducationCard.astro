---
import Icon from './Icon.astro';
import type { Education } from '../data/content';

interface Props {
  info: Education;
}

const { info } = Astro.props;
---

<article class="vs-card">
  <img class="vs-card-img" src={info.img} alt="" loading="lazy" decoding="async" />
  <div class="vs-card-body">
    <h3 class="vs-card-title">{info.title}</h3>
    <p class="vs-card-subtitle">{info.subtitle}</p>
    <a href={info.url} target="_blank" rel="noopener noreferrer" class="vs-card-link">{info.center}</a>
    <div class="vs-card-footer">
      <span class="vs-chip vs-chip--date"><Icon name="calendar" />{info.date}</span>
      <img class="vs-edu-icon" src={info.icon} alt={info.center} loading="lazy" decoding="async" />
    </div>
  </div>
</article>

<style>
  .vs-card-img {
    width: 100%;
    height: 120px;
    object-fit: cover;
    display: block;
    filter: saturate(0.65) sepia(0.2) brightness(0.95);
  }

  .vs-card-body {
    padding: 20px;
  }

  .vs-card-title {
    font-size: 1.15rem;
    margin-bottom: 6px;
  }

  .vs-card-subtitle {
    color: var(--color-text-sec);
    font-size: 0.85rem;
    margin-bottom: 12px;
    line-height: 1.5;
  }

  .vs-card-link {
    display: block;
    margin-bottom: 10px;
  }

  .vs-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
  }

  .vs-edu-icon {
    width: 90px;
    height: 36px;
    margin-top: 50px;
    border-radius: var(--radius-card);
    object-fit: contain;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid var(--color-border);
    padding: 4px 6px;
    filter: saturate(0.65) sepia(0.2) brightness(0.95);
  }
</style>

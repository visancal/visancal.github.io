---
import type { Education } from '../data/content';

interface Props {
  info: Education;
}

const { info } = Astro.props;
---

<div class="vs-card-wrap">
  <article class="vs-card">
    <img class="vs-card-img" src={info.img} alt={info.center} loading="lazy" />
    <div class="vs-card-body">
      <h3 class="vs-card-title">{info.title}</h3>
      <p class="vs-card-subtitle">{info.subtitle}</p>
      <div class="vs-card-text">
        <a href={info.url} target="_blank" rel="noopener noreferrer" class="vs-center-link">
          {info.center}
        </a>
        <div class="vs-date-chip">
          <i class="mdi mdi-calendar-month"></i>
          {info.date}
        </div>
        <img class="vs-edu-icon" src={info.icon} alt={info.center} loading="lazy" />
      </div>
    </div>
  </article>
</div>

<style>
  .vs-card-wrap {
    width: 100%;
    padding: 8px;
  }

  .vs-card {
    background: var(--color-surface);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .vs-card:hover {
    box-shadow: 0 4px 8px rgba(0,0,0,0.06), 0 12px 32px rgba(0,0,0,0.08);
    transform: translateY(-2px);
  }

  .vs-card-img {
    width: 100%;
    height: 120px;
    object-fit: cover;
    display: block;
    filter: saturate(0.65) sepia(0.2) brightness(0.95);
  }

  .vs-card-body {
    padding: 20px;
    position: relative;
  }

  .vs-card-title {
    color: var(--color-text);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    margin-bottom: 6px;
  }

  .vs-card-subtitle {
    color: var(--color-text-sec);
    font-size: 0.85rem;
    margin-bottom: 12px;
    line-height: 1.5;
  }

  .vs-card-text {
    position: relative;
    padding-bottom: 65px;
  }

  .vs-center-link {
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    display: block;
    margin-bottom: 10px;
    transition: color 0.15s;
  }

  .vs-center-link:hover {
    color: var(--color-accent-dk);
  }

  .vs-date-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: rgba(217, 119, 87, 0.12);
    color: var(--color-accent);
    font-size: 0.72rem;
    font-weight: 500;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(217, 119, 87, 0.25);
  }

  .vs-edu-icon {
    width: 90px;
    height: 36px;
    position: absolute;
    bottom: 0;
    right: 0;
    border-radius: var(--radius-card);
    object-fit: contain;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid var(--color-border);
    padding: 4px 6px;
    filter: saturate(0.65) sepia(0.2) brightness(0.95);
  }

  @media (min-width: 768px) {
    .vs-card-wrap {
      width: 50%;
    }
  }

  @media (min-width: 1280px) {
    .vs-card-wrap {
      width: 33.333%;
    }
  }
</style>

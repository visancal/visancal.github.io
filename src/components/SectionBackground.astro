---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="vs-section">
  <p class="vs-section-title">{title}</p>
  <slot />
</section>

<style>
  .vs-section {
    margin-top: 12px;
    padding: 0 12px;
  }

  .vs-section-title {
    color: var(--color-primary);
    font-size: 1.9rem;
    font-weight: 300;
    font-family: var(--font-display);
    margin: 0 12px 8px;
  }

  @media (max-width: 600px) {
    .vs-section {
      padding: 0 4px;
    }
  }
</style>

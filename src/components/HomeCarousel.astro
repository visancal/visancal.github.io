---
interface Slide {
  src: string;
  credits: string;
  link: string;
  place: string;
}

interface Props {
  slides: Slide[];
  interval?: number;
}

const { slides, interval = 15000 } = Astro.props;
---

<div class="vs-carousel" data-carousel data-interval={interval}>
  {slides.map((slide, i) => (
    <div
      class:list={['vs-slide', { 'vs-slide--active': i === 0 }]}
      style={`background-image: url('${slide.src}')`}
    >
      {i === 0 && (
        <div class="vs-slide-content">
          <h1 class="vs-hello">Hey, I'm Vicent</h1>
          <p class="vs-description">GIS developer, travel &amp; cycling lover based in Valencia, Spain</p>
          <div class="vs-actions">
            <a href="/background" class="vs-btn-more">Learn more</a>
          </div>
        </div>
      )}
      {i !== 0 && (
        <div class="vs-slide-content vs-slide-content--hidden">
          <h1 class="vs-hello">Hey, I'm Vicent</h1>
          <p class="vs-description">GIS developer, travel &amp; cycling lover based in Valencia, Spain</p>
          <div class="vs-actions">
            <a href="/background" class="vs-btn-more">Learn more</a>
          </div>
        </div>
      )}
      {(slide.place || slide.credits) && (
        <div class="vs-credits">
          {slide.place && <div>{slide.place}</div>}
          {slide.credits && (
            <div>
              <i class="mdi mdi-camera vs-credits-cam"></i>
              {slide.link
                ? <a href={slide.link} target="_blank" rel="noopener noreferrer">{slide.credits}</a>
                : <span>{slide.credits}</span>
              }
            </div>
          )}
        </div>
      )}
    </div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((el) => {
    const slides = el.querySelectorAll<HTMLElement>('.vs-slide');
    const ms = parseInt(el.dataset.interval ?? '15000', 10);
    let cur = 0;

    setInterval(() => {
      slides[cur].classList.remove('vs-slide--active');
      cur = (cur + 1) % slides.length;
      slides[cur].classList.add('vs-slide--active');
    }, ms);
  });
</script>

<style>
  .vs-carousel {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .vs-slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
  }

  /* Warm earthy overlay — tints the image without affecting text (text sits above via z-index) */
  .vs-slide::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      /* Warm amber colour wash */
      linear-gradient(rgba(180, 100, 40, 0.12), rgba(160, 85, 30, 0.12)),
      /* Dark gradient for text readability */
      linear-gradient(
        to bottom,
        rgba(70, 38, 12, 0.52) 0%,
        rgba(50, 25, 8, 0.18) 48%,
        rgba(70, 38, 12, 0.65) 100%
      );
  }

  .vs-slide--active {
    opacity: 1;
  }

  .vs-slide-content {
    position: relative;
    z-index: 1;
    margin-top: 180px;
    margin-left: 64px;
    max-width: 620px;
  }

  .vs-hello {
    font-family: var(--font-display);
    font-size: 3.8rem;
    color: #ffffff;
    line-height: 1.1;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
    text-shadow: 0 2px 12px rgba(0,0,0,0.25);
  }

  .vs-description {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.88);
    font-weight: 300;
    line-height: 1.7;
    margin-bottom: 36px;
    max-width: 440px;
  }

  .vs-btn-more {
    display: inline-block;
    padding: 12px 28px;
    background: var(--color-accent);
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 500;
    border-radius: var(--radius-pill);
    letter-spacing: 0.01em;
    transition: background 0.2s, transform 0.15s;
  }

  .vs-btn-more:hover {
    background: var(--color-accent-dk);
    transform: translateY(-1px);
  }

  .vs-credits {
    position: absolute;
    bottom: 16px;
    left: 16px;
    z-index: 1;
    color: rgba(255,255,255,0.75);
    background: rgba(0, 0, 0, 0.25);
    border-radius: var(--radius-pill);
    font-size: 0.68rem;
    font-weight: 400;
    padding: 3px 10px;
    backdrop-filter: blur(4px);
  }

  .vs-credits-cam {
    color: var(--color-accent);
    font-size: 0.8rem;
    vertical-align: middle;
  }

  .vs-credits a {
    color: rgba(255,255,255,0.9);
    margin-left: 4px;
  }

  .vs-credits a:hover {
    color: #ffffff;
  }

  @media (max-width: 600px) {
    .vs-slide-content {
      margin-top: 160px;
      margin-left: 20px;
    }
    .vs-hello {
      font-size: 2.2rem;
    }
    .vs-description {
      font-size: 1rem;
    }
  }
</style>

---
interface Slide {
  src: string;
  srcMobile?: string;
  credits: string;
  link: string;
  place: string;
  bgPosition?: string;
  bgPositionMobile?: string;
}

interface Props {
  slides: Slide[];
  interval?: number;
}

const { slides, interval = 7000 } = Astro.props;
---

<div class="vs-carousel" data-carousel data-interval={interval}>
  {slides.map((slide, i) => (
    <div
      class:list={['vs-slide', { 'vs-slide--active': i === 0 }]}
      style={`--bg-src: url('${slide.src}'); ${slide.srcMobile ? `--bg-src-mobile: url('${slide.srcMobile}');` : ''} --bg-pos: ${slide.bgPosition ?? 'center'}; --bg-pos-mobile: ${slide.bgPositionMobile ?? slide.bgPosition ?? 'center'};`}
    >
      {i === 0 && (
        <div class="vs-slide-content">
          <h1 class="vs-hello">Hey, I'm Vicent</h1>
          <p class="vs-description">GIS developer, AI enthusiast, travel &amp; cycling lover based in Valencia, Spain</p>
          <div class="vs-actions">
            <a href="/background" class="vs-btn-more">Learn more</a>
          </div>
          <div class="vs-social-mobile">
            <a href="https://twitter.com/visancal" target="_blank" rel="noopener noreferrer" aria-label="Twitter" class="vs-social-icon"><i class="mdi mdi-twitter"></i></a>
            <a href="https://www.instagram.com/visancal/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="vs-social-icon"><i class="mdi mdi-instagram"></i></a>
            <a href="https://www.linkedin.com/in/vsanjaime/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="vs-social-icon"><i class="mdi mdi-linkedin"></i></a>
            <a href="https://github.com/visancal" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="vs-social-icon"><i class="mdi mdi-github"></i></a>
            <a href="https://strava.app.link/qXSmcgCTZ2b" target="_blank" rel="noopener noreferrer" aria-label="Strava" class="vs-social-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="1em" height="1em" aria-hidden="true"><path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/></svg></a>
          </div>
        </div>
      )}
      {i !== 0 && (
        <div class="vs-slide-content">
          <h1 class="vs-hello">Hey, I'm Vicent</h1>
          <p class="vs-description">GIS developer, AI enthusiast, travel &amp; cycling lover based in Valencia, Spain</p>
          <div class="vs-actions">
            <a href="/background" class="vs-btn-more">Learn more</a>
          </div>
          <div class="vs-social-mobile">
            <a href="https://twitter.com/visancal" target="_blank" rel="noopener noreferrer" aria-label="Twitter" class="vs-social-icon"><i class="mdi mdi-twitter"></i></a>
            <a href="https://www.instagram.com/visancal/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="vs-social-icon"><i class="mdi mdi-instagram"></i></a>
            <a href="https://www.linkedin.com/in/vsanjaime/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="vs-social-icon"><i class="mdi mdi-linkedin"></i></a>
            <a href="https://github.com/visancal" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="vs-social-icon"><i class="mdi mdi-github"></i></a>
            <a href="https://strava.app.link/qXSmcgCTZ2b" target="_blank" rel="noopener noreferrer" aria-label="Strava" class="vs-social-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="1em" height="1em" aria-hidden="true"><path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/></svg></a>
          </div>
        </div>
      )}
      {(slide.place || slide.credits) && (
        <div class="vs-credits">
          {slide.place && <div>{slide.place}</div>}
          {slide.credits && (
            <div>
              <i class="mdi mdi-camera vs-credits-cam"></i>
              {slide.link
                ? <a href={slide.link} target="_blank" rel="noopener noreferrer">{slide.credits}</a>
                : <span>{slide.credits}</span>
              }
            </div>
          )}
        </div>
      )}
    </div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((el) => {
    const slides = el.querySelectorAll<HTMLElement>('.vs-slide');
    const ms = parseInt(el.dataset.interval ?? '15000', 10);
    let cur = 0;

    setInterval(() => {
      slides[cur].classList.remove('vs-slide--active');
      cur = (cur + 1) % slides.length;
      slides[cur].classList.add('vs-slide--active');
    }, ms);
  });
</script>

<style>
  .vs-carousel {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .vs-slide {
    position: absolute;
    inset: 0;
    background-image: var(--bg-src);
    background-size: cover;
    background-position: var(--bg-pos, center);
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
  }

  /* Warm earthy overlay — tints the image without affecting text (text sits above via z-index) */
  .vs-slide::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      /* Warm amber colour wash */
      linear-gradient(rgba(180, 100, 40, 0.12), rgba(160, 85, 30, 0.12)),
      /* Dark gradient for text readability */
      linear-gradient(
        to bottom,
        rgba(70, 38, 12, 0.52) 0%,
        rgba(50, 25, 8, 0.18) 48%,
        rgba(70, 38, 12, 0.65) 100%
      );
  }

  .vs-slide--active {
    opacity: 1;
  }

  .vs-slide-content {
    position: relative;
    z-index: 1;
    margin-top: 180px;
    margin-left: 64px;
    max-width: 620px;
  }

  .vs-hello {
    font-family: var(--font-display);
    font-size: 3.8rem;
    color: #ffffff;
    line-height: 1.1;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
    text-shadow: 0 2px 12px rgba(0,0,0,0.25);
  }

  .vs-description {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.95);
    font-weight: 500;
    line-height: 1.7;
    margin-bottom: 36px;
    max-width: 440px;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.4);
  }

  .vs-btn-more {
    display: inline-block;
    padding: 12px 28px;
    background: var(--color-accent);
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 500;
    border-radius: var(--radius-pill);
    letter-spacing: 0.01em;
    transition: background 0.2s, transform 0.15s;
  }

  .vs-btn-more:hover {
    background: var(--color-accent-dk);
    transform: translateY(-1px);
  }

  .vs-credits {
    position: absolute;
    bottom: 16px;
    left: 16px;
    z-index: 1;
    color: rgba(255,255,255,0.75);
    background: rgba(0, 0, 0, 0.25);
    border-radius: var(--radius-pill);
    font-size: 0.68rem;
    font-weight: 400;
    padding: 3px 10px;
    backdrop-filter: blur(4px);
  }

  .vs-credits-cam {
    color: var(--color-accent);
    font-size: 0.8rem;
    vertical-align: middle;
  }

  .vs-credits a {
    color: rgba(255,255,255,0.9);
    margin-left: 4px;
  }

  .vs-credits a:hover {
    color: #ffffff;
  }

  /* Social icons — hidden on desktop (shown in header), visible on mobile */
  .vs-social-mobile {
    display: none;
  }

  @media (max-width: 600px) {
    .vs-slide {
      background-image: var(--bg-src-mobile, var(--bg-src));
      background-position: var(--bg-pos-mobile, var(--bg-pos, center));
    }
    .vs-slide-content {
      margin-top: 160px;
      margin-left: 28px;
      margin-right: 28px;
    }
    .vs-hello {
      font-size: 2.2rem;
    }
    .vs-description {
      font-size: 1rem;
    }
    .vs-social-mobile {
      display: flex;
      gap: 4px;
      margin-top: 24px;
    }
    .vs-social-icon {
      color: rgba(255, 255, 255, 0.85);
      font-size: 1.4rem;
      display: inline-flex;
      align-items: center;
      padding: 6px 8px;
      border-radius: var(--radius-pill);
      transition: color 0.15s, background 0.15s;
    }
    .vs-social-icon:hover {
      color: #ffffff;
      background: rgba(255, 255, 255, 0.15);
    }
  }
</style>

---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import { SITE_URL } from '../data/content';
import { DEFAULT_LANG, LANGS, LANG_META, getLang, localizePath, routePath, ui } from '../data/i18n';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Optional JSON-LD schema objects to inject alongside the default Person schema */
  schemas?: object[];
}

const SITE_NAME = 'Vicent Sanjaime';

const lang = getLang(Astro.url);
const text = ui[lang];
const route = routePath(Astro.url);

const {
  title       = `Vicent Sanjaime | ${text.jobTitle}`,
  description = text.defaultDescription,
  ogImage     = `${SITE_URL}/img/home/intro.webp`,
  schemas = [],
} = Astro.props;

const canonical = `${SITE_URL}${localizePath(route, lang)}`;
const alternates = LANGS.map((l) => ({ hreflang: LANG_META[l].hreflang, href: `${SITE_URL}${localizePath(route, l)}` }));

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  /*
   * Primary name: Valencian form (official).
   * alternateName covers the Castilian variant "Vicente" and the full
   * two-surname form "Sanjaime Calvet" so Google's Knowledge Graph can
   * unify all three query intents to the same entity.
   */
  name: 'Vicent Sanjaime',
  givenName: 'Vicent',
  familyName: 'Sanjaime Calvet',
  alternateName: [
    'Vicente Sanjaime',
    'Vicente Sanjaime Calvet',
    'Vicent Sanjaime Calvet',
  ],
  url: SITE_URL,
  image: `${SITE_URL}/img/home/intro.webp`,
  jobTitle: text.jobTitle,
  description: text.personDescription,
  worksFor: {
    '@type': 'Organization',
    name: 'CARTO',
    url: 'https://carto.com',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Valencia',
    addressCountry: 'ES',
  },
  alumniOf: [
    {
      '@type': 'CollegeOrUniversity',
      name: 'Polytechnic University of Valencia',
      url: 'http://www.upv.es/',
    },
    {
      '@type': 'CollegeOrUniversity',
      name: 'University of Valencia',
      url: 'http://www.uv.es/',
    },
  ],
  knowsLanguage: ['Spanish', 'Catalan', 'English'],
  sameAs: [
    'https://www.linkedin.com/in/vsanjaime/',
    'https://github.com/visancal',
    'https://twitter.com/visancal',
    'https://x.com/visancal',
    'https://www.instagram.com/visancal/',
  ],
  knowsAbout: [
    'GIS', 'Geospatial development', 'Web mapping', 'Cartography', 'Geodesy',
    'Vue.js', 'React', 'TypeScript', 'Astro', 'OpenLayers', 'Leaflet', 'Deck.gl',
    'PostGIS', 'GeoServer', 'CARTO', 'BigQuery', 'Docker', 'Kubernetes',
  ],
};
---

<!doctype html>
<html lang={LANG_META[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#D97757" />

    <!--
      Static hosting has no Accept-Language negotiation, so English pages (unprefixed) send the
      visitor to /es/ or /va/ before first paint when that is their language: the one picked in
      the header switcher (localStorage) or else the first supported one in navigator.languages.
    -->
    {lang === DEFAULT_LANG && (
      <script is:inline>
        (function () {
          var lang;
          try { lang = localStorage.getItem('vs-lang'); } catch (e) {}
          if (lang !== 'en' && lang !== 'es' && lang !== 'va') {
            lang = 'en';
            var prefs = navigator.languages || [navigator.language];
            for (var i = 0; i < prefs.length; i++) {
              var code = String(prefs[i]).toLowerCase().split('-')[0];
              if (code === 'en' || code === 'es') { lang = code; break; }
              if (code === 'ca') { lang = 'va'; break; }
            }
          }
          if (lang !== 'en') location.replace('/' + lang + location.pathname + location.search + location.hash);
        })();
      </script>
    )}

    <!--
      Random theme pick — once per browser session, applied before first paint
      to avoid a flash. Default (no attribute) is warm; "sage" is the green theme.
    -->
    <script is:inline>
      (function () {
        function pickTheme() {
          var theme;
          try { theme = sessionStorage.getItem('vs-theme'); } catch (e) {}
          if (theme !== 'warm' && theme !== 'sage') {
            theme = Math.random() < 0.5 ? 'warm' : 'sage';
            try { sessionStorage.setItem('vs-theme', theme); } catch (e) {}
          }
          return theme;
        }
        function applyTheme(doc) {
          var theme = pickTheme();
          doc.documentElement.setAttribute('data-theme', theme);
          var meta = doc.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', theme === 'sage' ? '#2F7D6B' : '#D97757');
        }
        applyTheme(document);
        // Apply to the incoming document before it is swapped in (no flash between pages)
        document.addEventListener('astro:before-swap', function (e) { applyTheme(e.newDocument); });
      })();
    </script>

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Vicent Sanjaime Calvet" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.ico" />

    <!-- Open Graph (LinkedIn, Facebook, WhatsApp…) -->
    <meta property="og:type"        content="website" />
    <meta property="og:site_name"   content={SITE_NAME} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url"         content={canonical} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:image:alt"   content={title} />
    <meta property="og:locale"      content={LANG_META[lang].ogLocale} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={LANG_META[l].ogLocale} />)}

    <!-- Twitter / X Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:site"        content="@visancal" />
    <meta name="twitter:creator"     content="@visancal" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />
    <meta name="twitter:image:alt"   content={title} />

    <!-- Structured data (Person + any page-specific schemas) -->
    {[personSchema, ...schemas].map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Self-hosted fonts (see astro.config.mjs) -->
    <Font cssVariable="--font-main" preload={[{ weight: '400' }]} />
    <Font cssVariable="--font-display" preload />

    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>

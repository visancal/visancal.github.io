---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Vicent Sanjaime',
  description = 'Vicent Sanjaime personal website. GIS developer and travel lover',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;500;900&family=Special+Elite&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@mdi/font@7/css/materialdesignicons.min.css"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-primary: #1b237b;
    --color-accent: #b21b57;
    --color-secondary: #d03c3b;
    --color-link: #005798;
    --font-main: Roboto, sans-serif;
    --font-display: 'Special Elite', sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    overflow-y: hidden;
    font-weight: 300;
  }

  body {
    font-family: var(--font-main);
    font-weight: 300;
  }

  a {
    text-decoration: none;
  }

  ul {
    list-style: none;
  }

  ul li::before {
    content: '\2022';
    color: var(--color-secondary);
    font-weight: bold;
    display: inline-block;
    width: 1.4em;
    margin-left: -1.3em;
  }
</style>
